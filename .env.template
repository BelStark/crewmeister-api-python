# Copy to .env; never commit real credentials or employee data.
# CLI: crewmeister --env-file .env <command> (install the cli extra).
# MCP: crewmeister-mcp --env-file .env (install the mcp extra).
# Existing environment variables override this file; the SDK never loads it implicitly.

# Select the intended endpoint explicitly. Stage is NOT an isolated sandbox.
CREWMEISTER_API_BASE_URL=https://api.crewmeister-stage.com

# Enable exactly one credential form: a bearer token OR username and password.
# CREWMEISTER_API_BEARER_TOKEN=<your_bearer_token>
# CREWMEISTER_API_USERNAME=<your_username>
# CREWMEISTER_API_PASSWORD=<your_password>

CREWMEISTER_API_CALLER_CONTEXT={}
CREWMEISTER_API_TIMEOUT_SECONDS=30
CREWMEISTER_API_PAGE_SIZE=100
